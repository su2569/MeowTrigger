{
  "plugin_name": "数学计算器",
  "author": "MeowTrigger",
  "description": "复杂数学表达式计算器：支持常量/函数/进制/分数/大数/统计/复数",
  "triggers": [
    {
      "name": "数学计算",
      "trigger_type": "command",
      "trigger_pattern": "calc",
      "response_type": "script_file",
      "response_content": "scripts/math_calc.py",
      "script_type": "python",
      "execution_mode": "local",
      "permission": "all",
      "cooldown": 2,
      "description": "用法: /calc <表达式>"
    },
    {
      "name": "数学计算-中文",
      "trigger_type": "fullmatch",
      "trigger_pattern": "计算",
      "response_type": "script_file",
      "response_content": "scripts/math_calc.py",
      "script_type": "python",
      "execution_mode": "local",
      "permission": "all",
      "cooldown": 2,
      "description": "用法: 计算 <表达式>"
    }
  ]
}